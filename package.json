{
  "name": "agentwindtunnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:runner": "node --test tests/simulator.test.ts tests/runner.test.ts",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "test:fixtures": "node --test tests/fixtures.test.ts tests/harness.test.ts",
    "test:release": "node scripts/test.mjs --strict"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
