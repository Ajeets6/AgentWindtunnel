{
  "name": "agentwindtunnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "vite build --config apps/web/vite.config.ts",
    "dev": "npm run build && npm start",
    "start": "node apps/server/main.ts",
    "test:api": "node --test tests/api-security.test.ts tests/api-integration.test.ts",
    "typecheck": "tsc --noEmit",
    "test:runner": "node --test tests/simulator.test.ts tests/runner.test.ts tests/runner-integration.test.ts",
    "simulate": "node packages/cli/main.ts",
    "test": "npm run build && node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "test:fixtures": "node --test tests/fixtures.test.ts tests/harness.test.ts",
    "test:release": "npm run build && node scripts/test.mjs --strict",
    "test:web": "npm run build && node --test tests/web-security.test.ts tests/web-integration.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
